{
  "name": "composition-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "npm install --no-audit --no-fund",
    "dev": "vite",
    "build": "mkdir .tmp 2>nul & set \"TEMP=%CD%\\.tmp\" & set \"TMP=%CD%\\.tmp\" & tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": ".\\src-tauri\\target\\debug\\composition-designer.exe --project ..\\..\\examples\\minimal-project",
    "start-invalid": ".\\src-tauri\\target\\debug\\composition-designer.exe --project ..\\..\\examples\\invalid-projects\\connections\\errors",
    "start-topmost": ".\\src-tauri\\target\\debug\\composition-designer.exe --project ..\\..\\examples\\minimal-project --topmost",
    "desktop": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/legacy-modes": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xyflow/react": "^12.0.0",
    "codemirror": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
